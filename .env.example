# ============================================================
# Kemo Engine — environment template
#
# Copy to .env for local development. In production these live in
# Coolify (Application → Environment Variables), never in a file.
#
# The frontend and API ship in one container and are served from the same
# origin, so the browser needs almost nothing at build time. VITE_* values
# are inlined into the bundle and are PUBLIC — never put a secret in one.
# ============================================================

# --- Server (secret) ----------------------------------------
# PostgreSQL. In Coolify use the database's INTERNAL url.
DATABASE_URL=postgres://kemo:password@localhost:5432/kemo

# Signs session tokens. Must be at least 32 characters — the server refuses
# to start below that. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- AI provider ---------------------------------------------
# Get a key at https://openrouter.ai/keys
# This is the ONLY place the key exists. It never reaches the browser.
OPENROUTER_API_KEY=

# The model the server uses for every request. This is the single source of
# truth — the frontend does not send a model at all.
# Browse ids at https://openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: extra model ids the client is allowed to request, comma-separated.
# Leave empty unless you need it.
#
# ⚠️ Credits are priced per ACTION, not per model (see server/src/lib/credits.js).
# Anything listed here can be bought at that same fixed price, so only add models
# whose cost is comparable to OPENROUTER_MODEL above.
OPENROUTER_ALLOWED_MODELS=

# Optional: point the upstream call at a mock or a gateway instead of OpenRouter.
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# Public URL of the deployment. Used for the OpenRouter referer header and the
# post-checkout redirect.
#
# REQUIRED for payments: /api/create-checkout returns 500 without it. The
# redirect is never taken from the request's Origin header, because a caller
# could then point it at their own domain and receive buyers straight after
# they have entered card details.
APP_URL=https://kemo.example.com

NODE_ENV=production
PORT=3000

# --- Sessions & limits (optional) ---------------------------
SESSION_DAYS=7
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60000
SIGNUP_BONUS_CREDITS=20

# --- Payments (optional — checkout is disabled without these) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMON_VARIANT_BASIC=
LEMON_VARIANT_PRO=
LEMON_VARIANT_PREMIUM=

# --- Browser (PUBLIC — inlined into the bundle at build time) ---
# Only the plan variant ids, so the pricing page knows what to offer.
# Not secrets: they appear in checkout URLs anyway.
VITE_LEMON_VARIANT_BASIC=
VITE_LEMON_VARIANT_PRO=
VITE_LEMON_VARIANT_PREMIUM=

# --- Admin access -------------------------------------------
# Admins are flagged in the database, not by env var:
#   UPDATE users SET is_admin = TRUE WHERE LOWER(email) = LOWER('you@example.com');
