# ============================================================
# Kemo Engine — environment template
#
# Copy to .env for local development. In production these live in
# Coolify (Application → Environment Variables), never in a file.
#
# The frontend and API ship in one container and are served from the same
# origin, so the browser needs almost nothing at build time. VITE_* values
# are inlined into the bundle and are PUBLIC — never put a secret in one.
# ============================================================

# --- Server (secret) ----------------------------------------
# PostgreSQL. In Coolify use the database's INTERNAL url.
DATABASE_URL=postgres://kemo:password@localhost:5432/kemo

# Signs session tokens. Must be at least 32 characters — the server refuses
# to start below that. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Public URL of the deployment. Used for the OpenRouter referer header and
# the post-checkout redirect.
APP_URL=https://kemo.example.com

NODE_ENV=production
PORT=3000

# --- Sessions & limits (optional) ---------------------------
SESSION_DAYS=7
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60000
SIGNUP_BONUS_CREDITS=20

# --- Payments (optional — checkout is disabled without these) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMON_VARIANT_BASIC=
LEMON_VARIANT_PRO=
LEMON_VARIANT_PREMIUM=

# --- Browser (PUBLIC — inlined into the bundle at build time) ---
# Only the plan variant ids, so the pricing page knows what to offer.
# Not secrets: they appear in checkout URLs anyway.
VITE_LEMON_VARIANT_BASIC=
VITE_LEMON_VARIANT_PRO=
VITE_LEMON_VARIANT_PREMIUM=

# --- Admin access -------------------------------------------
# Admins are flagged in the database, not by env var:
#   UPDATE users SET is_admin = TRUE WHERE LOWER(email) = LOWER('you@example.com');
