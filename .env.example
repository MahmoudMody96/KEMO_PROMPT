# PromptForge Environment Variables
# Copy this file as .env and fill in your values.
#
# Only VITE_* variables reach the browser. Everything else is server-only and
# belongs in the Vercel dashboard, never in this file on a deployed project.

# === LOCAL DEVELOPMENT ===
# Point the frontend at a backend proxy.
#   Option A (recommended): `vercel dev` — runs the real /api functions with
#                           auth + credits. Leave VITE_BACKEND_URL empty.
#   Option B: `cd server && npm run dev` — unmetered proxy on :3001.
VITE_USE_BACKEND=true
VITE_BACKEND_URL=

# === SUPABASE (Auth + Database) ===
# Get from: supabase.com → Project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# === LEMONSQUEEZY (client-side variant IDs) ===
VITE_LEMONSQUEEZY_STORE_ID=your_store_id
VITE_LEMON_VARIANT_BASIC=your_basic_variant_id
VITE_LEMON_VARIANT_PRO=your_pro_variant_id
VITE_LEMON_VARIANT_PREMIUM=your_premium_variant_id

# ============================================================
# SERVER-ONLY — set these in the Vercel dashboard, not here
# ============================================================
#
# OPENROUTER_API_KEY=sk-or-v1-...
#     Never expose to the frontend.
#
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
#     Bypasses RLS. Required — without it /api/generate and /api/vision refuse
#     to serve, because they could not verify who is calling or charge credits.
#
# SUPABASE_URL=https://your-project.supabase.co
#     Falls back to VITE_SUPABASE_URL if unset.
#
# LEMONSQUEEZY_API_KEY=your_api_key
# LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret
#
# APP_URL=https://kemo-prompt.vercel.app
#     Used for the OpenRouter referer and the checkout redirect.
#
# ALLOWED_ORIGINS=https://kemo-prompt.vercel.app,https://your-custom-domain.com
#     Comma-separated CORS allowlist. *.vercel.app is always permitted.
#
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW=60000
#
# ALLOW_ANONYMOUS=true
#     DEVELOPMENT ONLY. Lets unauthenticated callers use the AI endpoints with
#     no credit charge. Never set this on a deployed environment — it turns the
#     API into a free public proxy for your OpenRouter key.

# === ADMIN ACCESS ===
# Admins are flagged in the database, not by env var:
#   UPDATE public.profiles SET is_admin = TRUE WHERE email = 'you@example.com';
