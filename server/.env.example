# Local dev proxy environment (server/.env)
#
# This proxy has NO auth and NO credit metering — it exists only so the app
# runs locally without the Vercel CLI. It refuses to boot unless you opt in.

OPENROUTER_API_KEY=your_openrouter_api_key_here
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60000

# Required acknowledgement that this endpoint is unmetered. Local use only.
ALLOW_ANONYMOUS=true
