# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables
# Broad by default: the previous list named only .env, .env.local and
# server/.env, so a future .env.production or server/.env.local would have been
# committed. .env.example is the one file that must stay tracked.
.env*
server/.env*
!.env.example

# Build artifacts
build_output.txt

# Local scripts (may contain personal paths)
*.bat

# Security — prevent accidental key/cert commits
*.pem
*.key

# (src/api/_extract.ps1 was a one-shot migration script that sliced the old
#  monolithic promptApi.js by line number. Its output has been committed for a
#  long time and its offsets no longer refer to anything, so it was deleted.)

# Tooling state (not part of the app)
.claude-flow/
.claude/proven-config.json
.claude/.proven-config-version
.claude/settings.local.json

# Stray files from shell redirects
/[0-9]*
